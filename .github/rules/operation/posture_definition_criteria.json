{
  "version": "1.1.0",
  "domain": "posture_detection",
  "description": "Bad posture decision criteria and thresholds (v1.0 algorithm integrated)",
  "filters": {
    "one_euro": {
      "min_cutoff": 0.05,
      "beta": 0.005
    },
    "ema": {
      "alpha": 0.15
    },
    "indicator_ema": {
      "alpha": 0.15
    }
  },
  "baseline": {
    "capture": {
      "method": "distance_movement_ransac",
      "wait_seconds": 5.0,
      "collect_seconds": 1.0,
      "expected_samples": 20,
      "minimum_valid_frames": 120
    },
    "metrics": [
      "shoulder_width",
      "face_shoulder_ratio"
    ]
  },
  "global_rules": {
    "state_machine": {
      "states": [
        "NORMAL",
        "WARNING",
        "BAD_POSTURE"
      ],
      "transitions": [
        "NORMAL->WARNING",
        "WARNING->BAD_POSTURE",
        "BAD_POSTURE->WARNING",
        "WARNING->NORMAL"
      ],
      "thresholds": {
        "warning": 0.45,
        "bad_posture": 0.60
      },
      "temporal_validation": {
        "min_duration_sec": 1.5,
        "min_state_hold_sec": 1.8
      }
    }
  },
  "posture_types": {
    "recline": {
      "display_label": "기댄 자세 의심",
      "primary_conditions": {
        "face_far_score": {
          "operator": ">",
          "threshold": 0.0
        },
        "ratio_down_score": {
          "operator": ">",
          "threshold": 0.0
        }
      },
      "secondary_signals": [
        "face_shoulder_ratio_change",
        "shoulder_tilt_deg_change"
      ],
      "sustain_seconds": 1.5
    },
    "forward_head": {
      "display_label": "거북목 경향",
      "primary_conditions": {
        "face_near_score": {
          "operator": ">",
          "threshold": 0.0
        },
        "ratio_up_score": {
          "operator": ">=",
          "threshold": 0.08,
          "tuning_range": {
            "min": 0.08,
            "max": 0.10
          }
        }
      },
      "sustain_seconds": 1.5
    },
    "crossed_leg_estimated": {
      "display_label": "다리 꼰 자세 추정",
      "primary_conditions": {
        "abs_shoulder_tilt_deg": {
          "operator": ">",
          "threshold": 6
        }
      },
      "secondary_signals": [
        "neck_offset_baseline_increase"
      ],
      "sustain_seconds": 3,
      "repeat_window_seconds": 10
    },
    "chin_rest_estimated": {
      "display_label": "턱 괸 자세 의심",
      "primary_conditions": {
        "eye_line_tilt_deg": {
          "operator": ">=",
          "threshold": 8
        },
        "shoulder_tilt_deg": {
          "operator": ">=",
          "threshold": 6
        },
        "neck_offset_baseline_change_percent": {
          "operator": ">=",
          "threshold_percent": 10
        }
      },
      "auxiliary_signals": {
        "hand_near_face": {
          "distance_metric": "distance(hand_point, face_center)",
          "threshold": 0.12,
          "stability": {
            "window_seconds": 2,
            "frame_ratio_threshold": 0.6
          }
        },
        "chin_occlusion": {
          "occlusion_ratio_formula": "hand_pixels_in_lower_face / lower_face_pixels",
          "threshold": 0.25,
          "fallback": {
            "landmark_count_near_chin": {
              "operator": ">=",
              "threshold": 2
            }
          }
        },
        "hand_face_score": {
          "formula": "0.5 * near_score + 0.5 * occlusion_score"
        }
      },
      "sustain_seconds": 2
    }
  },
  "frame_scoring": {
    "score_range": [
      0.0,
      1.0
    ],
    "likelihood_weights": {
      "forward_head": {
        "face_near": 0.3,
        "ratio_up": 0.7
      },
      "recline": {
        "face_far": 0.3,
        "ratio_down": 0.7
      },
      "crossed_leg": {
        "tilt": 0.7,
        "neck_offset": 0.3
      },
      "chin_rest": {
        "eye": 0.35,
        "shoulder": 0.2,
        "neck": 0.15,
        "hand": 0.3
      }
    },
    "ratio_scale_k": 1.5,
    "score_normalization_max": 2.0,
    "hand_face_weights": {
      "near_score": 0.5,
      "occlusion_score": 0.5
    },
    "sensitivities": {
      "forward_head": 0.10,
      "recline": 0.04,
      "neck_offset": 10.0
    }
  },
  "event_judgment": {
    "immediate": "frame_threshold_exceeded",
    "confirmed": "sustained_for_n_seconds"
  },
  "message_policy": {
    "style": "use_estimation_phrasing",
    "examples": [
      "다리 꼰 자세 추정",
      "턱 괸 자세 의심",
      "거북목 경향"
    ]
  }
}
